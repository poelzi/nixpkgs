From 174efb99d9f410d1dc81bae854dcc504f5a77512 Mon Sep 17 00:00:00 2001
From: Daniel Poelzleithner <poelzleithner@b1-systems.de>
Date: Fri, 17 Jun 2022 15:09:58 +0200
Subject: [PATCH 3/3] Allows to enable registration through oauth provider but
 disable registration through normal sign in.

---
 config/config.default.php           | 2 ++
 includes/pages/guest_login.php      | 3 ++-
 src/Controllers/OAuthController.php | 4 +++-
 3 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/config/config.default.php b/config/config.default.php
index d0c07a95..00ea86c3 100644
--- a/config/config.default.php
+++ b/config/config.default.php
@@ -101,6 +101,8 @@ return [
             'hidden' => false,
             // Mark user as arrived when using this provider (optional)
             'mark_arrived' => false,
+            // Allow the user to register when normal register is off
+            'registration_enabled' => false,
         ],
         */
     ],
diff --git a/includes/pages/guest_login.php b/includes/pages/guest_login.php
index 0c1676e0..72e62f84 100644
--- a/includes/pages/guest_login.php
+++ b/includes/pages/guest_login.php
@@ -61,7 +61,7 @@ function guest_register()
         }
     }
 
-    if (!auth()->can('register') || (!$authUser && !config('registration_enabled'))) {
+    if (!auth()->can('register') || (!$authUser && !config('registration_enabled') && !$session->get('oauth2_register'))) {
         error(__('Registration is disabled.'));
 
         return page_with_title(register_title(), [
@@ -237,6 +237,7 @@ function guest_register()
                     ->associate($user)
                     ->save();
 
+                $session->remove('oauth2_register');
                 $session->remove('oauth2_connect_provider');
                 $session->remove('oauth2_user_id');
                 $session->remove('oauth2_access_token');
diff --git a/src/Controllers/OAuthController.php b/src/Controllers/OAuthController.php
index ecb0021f..e0237f24 100644
--- a/src/Controllers/OAuthController.php
+++ b/src/Controllers/OAuthController.php
@@ -340,7 +340,8 @@ class OAuthController extends BaseController
         array $config,
         Collection $userdata
     ): Response {
-        if (!$this->config->get('registration_enabled')) {
+        $config = $this->config->get('oauth')[$providerName];
+        if (!$this->config->get('registration_enabled') && $config['registration_enabled'] != true) {
             throw new HttpNotFound('oauth.not-found');
         }
 
@@ -359,6 +360,7 @@ class OAuthController extends BaseController
         );
         $this->session->set('oauth2_connect_provider', $providerName);
         $this->session->set('oauth2_user_id', $providerUserIdentifier);
+        $this->session->set('oauth2_register', $config['registration_enabled']);
 
         $expirationTime = $accessToken->getExpires();
         $expirationTime = $expirationTime ? Carbon::createFromTimestamp($expirationTime) : null;
-- 
